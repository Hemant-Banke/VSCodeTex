        "key": "alt+l up",
        "mac": "ctrl+l up",
        "when": "editorTextFocus && editorLangId =~ /^(la)?tex$/"
      },
      {
        "command": "texPreview.demoteSection",
        "key": "alt+l down",
        "mac": "ctrl+l down",
        "when": "editorTextFocus && editorLangId =~ /^(la)?tex$/"
      },
      {
        "command": "texPreview.insertSymbol",
        "key": "alt+l .",
        "mac": "ctrl+l .",
        "when": "editorTextFocus && editorLangId =~ /^(la)?tex$/"
      },
      {
        "command": "texPreview.showSymbols",
        "key": "alt+l p",
        "mac": "ctrl+l p",
        "when": "editorTextFocus && editorLangId =~ /^(la)?tex$/"
      },
      {
        "command": "texPreview.wordCount",
        "key": "alt+l alt+c",
        "mac": "ctrl+l ctrl+c",
        "when": "editorTextFocus && editorLangId =~ /^(la)?tex$/"
      },
      {
        "command": "texPreview.review.toggleTracking",
        "key": "alt+l r",
        "mac": "ctrl+l r",
        "when": "editorTextFocus && editorLangId =~ /^(la)?tex$/"
      },
      {
        "command": "texPreview.review.addComment",
        "key": "alt+l k",
        "mac": "ctrl+l k",
        "when": "editorTextFocus && editorLangId =~ /^(la)?tex$/"
      },
      {
        "command": "texPreview.review.accept",
        "key": "alt+l a",
        "mac": "ctrl+l a",
        "when": "editorTextFocus && editorLangId =~ /^(la)?tex$/"
      },
      {
        "command": "texPreview.review.reject",
        "key": "alt+l x",
        "mac": "ctrl+l x",
        "when": "editorTextFocus && editorLangId =~ /^(la)?tex$/"
      },
      {
        "command": "texPreview.review.nextChange",
        "key": "alt+l ]",
        "mac": "ctrl+l ]",
        "when": "editorTextFocus && editorLangId =~ /^(la)?tex$/"
      },
      {
        "command": "texPreview.review.previousChange",
        "key": "alt+l [",
        "mac": "ctrl+l [",
        "when": "editorTextFocus && editorLangId =~ /^(la)?tex$/"
      },
      {
        "command": "texPreview.endList",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == latex && texPreview.emptyItem && !suggestWidgetVisible && !inSnippetMode"
      }
    ],
    "configuration": {
      "title": "TeX Side Preview",
      "properties": {
        "texPreview.engine": {
          "type": "string",
          "enum": [
            "auto",
            "latexmk",
            "tectonic",
            "pdflatex",
            "xelatex",
            "lualatex"
          ],
          "default": "auto",
          "description": "Compiler to use. 'auto' picks the first available of latexmk, tectonic, pdflatex."
        },
        "texPreview.latexmkEngine": {
          "type": "string",
          "enum": [
            "pdf",
            "xelatex",
            "lualatex"
          ],
          "default": "pdf",
          "description": "Engine latexmk drives (-pdf, -xelatex or -lualatex)."
        },
        "texPreview.outDir": {
          "type": "string",
          "default": ".texbuild",
          "description": "Folder (relative to the root .tex file) for the PDF and auxiliary files. Use '.' to build next to the source."
        },
        "texPreview.compileOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Recompile whenever a .tex/.bib/.sty/.cls file is saved."
        },
        "texPreview.extraPath": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra directories to search for TeX binaries (added before the default macOS/Linux TeX locations)."
        },
        "texPreview.overleaf.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Two-way sync for folders cloned from Overleaf via Git: push on save, pull on a timer and when the window regains focus."
        },
        "texPreview.overleaf.pullInterval": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "description": "Seconds between checks for changes made on Overleaf."
        },
        "texPreview.overleaf.pushDelay": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "description": "Seconds to wait after a save before pushing, so quick successive saves go up as one commit."
        },
        "texPreview.buildCommand": {
          "type": "string",
          "default": "",
          "markdownDescription": "Shell command that replaces the built-in build, e.g. `latexmk -pdf -outdir=%OUTDIR% %DOC%`. Placeholders: `%DOC%` (main file without extension), `%DOCFILE%` (its name), `%TEX%`, `%DIR%`, `%OUTDIR%`. The PDF is expected at `%OUTDIR%/%DOCFILE%.pdf`."
        },
        "texPreview.docker.image": {
          "type": "string",
          "default": "",
          "markdownDescription": "Run the compiler inside this Docker image (e.g. `texlive/texlive`) instead of a local TeX install. The workspace folder is mounted at the same path."
        },
        "texPreview.invertPdf": {
          "type": "string",
          "enum": [
            "never",
            "darkTheme",
            "always"
          ],
          "default": "never",
          "enumDescriptions": [
            "Show the PDF as printed.",
            "Dark PDF when VS Code uses a dark theme.",
            "Always show a dark PDF."
          ],
          "markdownDescription": "Show the PDF with dark pages. The ◐ button in the preview toggles it for that preview."
        },
        "texPreview.chktex": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Lint `.tex` files with [ChkTeX](https://www.nongnu.org/chktex/) as you type (needs `chktex`, included in TeX Live)."
        },
        "texPreview.externalViewer.command": {
          "type": "string",
          "default": "",
          "markdownDescription": "Command for **TeX: Open PDF in External Viewer**, e.g. `open -a Skim %PDF%`. Empty opens the system's default PDF app."
        },
        "texPreview.externalViewer.syncCommand": {
          "type": "string",
          "default": "",
          "markdownDescription": "Forward search in the external viewer, used by **Jump to Location in PDF** when the PDF is open externally. Placeholders `%PDF%`, `%TEX%`, `%LINE%`, e.g. `/Applications/Skim.app/Contents/SharedSupport/displayline -r %LINE% %PDF% %TEX%`."
        },
        "texPreview.review.author": {
          "type": "string",
          "default": "",
          "markdownDescription": "Your name on comments and tracked changes. Empty uses Git's `user.name`."
        }
      }
    },
    "submenus": [
      {
        "id": "texPreview.latex",
        "label": "LaTeX"
      },
      {
        "id": "texPreview.format",
        "label": "Format"
      },
      {
        "id": "texPreview.structure",
        "label": "Structure"
      },
      {
        "id": "texPreview.reviewMenu",
        "label": "Review"
      }
    ],
    "viewsContainers": {
      "panel": [
