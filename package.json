{
  "name": "tex-side-preview",
  "displayName": "TeX Side Preview",
  "description": "Overleaf-style side-by-side LaTeX preview with SyncTeX, plus completions, hover previews, outline and two-way Overleaf sync — native to VS Code.",
  "version": "1.2.0",
  "publisher": "HemantBanke",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hemant-Banke/VSCodeTex.git"
  },
  "homepage": "https://github.com/Hemant-Banke/VSCodeTex#readme",
  "bugs": {
    "url": "https://github.com/Hemant-Banke/VSCodeTex/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Formatters",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "latex",
    "tex",
    "overleaf",
    "pdf",
    "preview",
    "pdf preview",
    "synctex",
    "live preview",
    "latexmk",
    "tectonic",
    "pdflatex",
    "xelatex",
    "bibtex",
    "academic",
    "paper",
    "thesis",
    "overleaf sync",
    "git",
    "intellisense",
    "bibtex formatter",
    "chktex",
    "mathjax"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:latex",
    "onLanguage:tex",
    "onLanguage:bibtex",
    "workspaceContains:**/*.tex",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "texPreview.open",
        "title": "Open TeX Preview to the Side",
        "category": "TeX",
        "icon": {
          "light": "media/preview-light.svg",
          "dark": "media/preview-dark.svg"
        }
      },
      {
        "command": "texPreview.compile",
        "title": "Recompile",
        "category": "TeX",
        "icon": "$(refresh)"
      },
      {
        "command": "texPreview.showLog",
        "title": "Show Compile Log",
        "category": "TeX"
      },
      {
        "command": "texPreview.syncToPdf",
        "title": "Jump to Location in PDF",
        "category": "TeX",
        "icon": "$(go-to-file)"
      },
      {
        "command": "texPreview.overleaf.clone",
        "title": "Clone Project…",
        "category": "Overleaf",
        "icon": "$(repo-clone)"
      },
      {
        "command": "texPreview.overleaf.syncNow",
        "title": "Sync Now",
        "category": "Overleaf",
        "icon": "$(sync)"
      },
      {
        "command": "texPreview.overleaf.menu",
        "title": "Sync Actions…",
        "category": "Overleaf"
      },
      {
        "command": "texPreview.overleaf.setToken",
        "title": "Set Git Token…",
        "category": "Overleaf"
      },
      {
        "command": "texPreview.stop",
        "title": "Stop Compiling",
        "category": "TeX",
        "icon": "$(debug-stop)"
      },
      {
        "command": "texPreview.clean",
        "title": "Clean Auxiliary Files",
        "category": "TeX"
      },
      {
        "command": "texPreview.openExternal",
        "title": "Open PDF in External Viewer",
        "category": "TeX"
      },
      {
        "command": "texPreview.wordCount",
        "title": "Count Words",
        "category": "TeX"
      },
      {
        "command": "texPreview.wrap",
        "title": "Surround with Command…",
        "category": "TeX"
      },
      {
        "command": "texPreview.wrapEnvironment",
        "title": "Surround with Environment…",
        "category": "TeX"
      },
      {
        "command": "texPreview.closeEnvironment",
        "title": "Close Current Environment",
        "category": "TeX"
      },
      {
        "command": "texPreview.toggleDisplayMath",
        "title": "Toggle \\[ \\] and equation*",
        "category": "TeX"
      },
      {
        "command": "texPreview.gotoMatchingEnvironment",
        "title": "Go to Matching \\begin / \\end",
        "category": "TeX"
      },
      {
        "command": "texPreview.endList",
        "title": "End List",
        "category": "TeX"
      },
      {
        "command": "texPreview.bold",
        "title": "Bold",
        "category": "TeX"
      },
      {
        "command": "texPreview.italic",
        "title": "Italic",
        "category": "TeX"
      },
      {
        "command": "texPreview.emph",
        "title": "Emphasis",
        "category": "TeX"
      },
      {
        "command": "texPreview.typewriter",
        "title": "Typewriter",
        "category": "TeX"
      },
      {
        "command": "texPreview.underline",
        "title": "Underline",
        "category": "TeX"
      },
      {
        "command": "texPreview.smallCaps",
        "title": "Small Caps",
        "category": "TeX"
      },
      {
        "command": "texPreview.footnote",
        "title": "Footnote",
        "category": "TeX"
      },
      {
        "command": "texPreview.wrapMath",
        "title": "Inline Math $…$",
        "category": "TeX"
      },
      {
        "command": "texPreview.promoteSection",
        "title": "Promote Heading",
        "category": "TeX"
      },
      {
        "command": "texPreview.demoteSection",
        "title": "Demote Heading",
        "category": "TeX"
      },
      {
        "command": "texPreview.toggleStar",
        "title": "Toggle Star (numbered / unnumbered)",
        "category": "TeX"
      },
      {
        "command": "texPreview.insertSymbol",
        "title": "Insert Symbol…",
        "category": "TeX",
        "icon": "$(symbol-operator)"
      },
      {
        "command": "texPreview.showSymbols",
        "title": "Show Symbol Palette",
        "category": "TeX",
        "icon": "$(symbol-operator)"
      },
      {
        "command": "texPreview.openInBrowser",
        "title": "Open Preview in Browser",
        "category": "TeX",
        "icon": "$(globe)"
      },
      {
        "command": "texPreview.menu",
        "title": "TeX Actions…",
        "category": "TeX"
      },
      {
        "command": "texPreview.review.toggleTracking",
        "title": "Track Changes",
        "category": "TeX Review",
        "icon": "$(record)",
        "toggled": "texPreview.tracking"
      },
      {
        "command": "texPreview.review.accept",
        "title": "Accept Change",
        "category": "TeX Review",
        "icon": "$(check)"
      },
      {
        "command": "texPreview.review.reject",
        "title": "Reject Change",
        "category": "TeX Review",
        "icon": "$(discard)"
      },
      {
        "command": "texPreview.review.acceptAll",
        "title": "Accept All Changes in File",
        "category": "TeX Review"
      },
      {
        "command": "texPreview.review.rejectAll",
        "title": "Reject All Changes in File",
        "category": "TeX Review"
      },
      {
        "command": "texPreview.review.nextChange",
        "title": "Next Change",
        "category": "TeX Review"
      },
      {
        "command": "texPreview.review.previousChange",
        "title": "Previous Change",
        "category": "TeX Review"
      },
      {
        "command": "texPreview.review.menu",
        "title": "Review…",
        "category": "TeX Review"
      },
      {
        "command": "texPreview.review.createComment",
        "title": "Add Comment",
        "category": "TeX Review"
      },
      {
        "command": "texPreview.review.reply",
        "title": "Reply",
        "category": "TeX Review"
      },
      {
        "command": "texPreview.review.resolve",
        "title": "Resolve",
        "category": "TeX Review",
        "icon": "$(check)"
      },
      {
        "command": "texPreview.review.reopen",
        "title": "Reopen",
        "category": "TeX Review",
        "icon": "$(debug-restart)"
      },
      {
        "command": "texPreview.review.deleteThread",
        "title": "Delete Thread",
        "category": "TeX Review",
        "icon": "$(trash)"
      },
      {
        "command": "texPreview.review.editComment",
        "title": "Edit",
        "category": "TeX Review",
        "icon": "$(edit)"
      },
      {
        "command": "texPreview.review.deleteComment",
        "title": "Delete",
        "category": "TeX Review",
        "icon": "$(trash)"
      },
      {
        "command": "texPreview.review.saveComment",
        "title": "Save",
        "category": "TeX Review"
      },
      {
        "command": "texPreview.review.cancelEdit",
        "title": "Cancel",
        "category": "TeX Review"
      },
      {
        "command": "texPreview.review.addComment",
        "title": "Add Comment",
        "category": "TeX Review",
        "icon": "$(comment)"
      },
      {
        "command": "texPreview.review.showComments",
        "title": "Show All Comments",
        "category": "TeX Review",
        "icon": "$(comment-discussion)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "texPreview.open",
          "when": "resourceExtname == .tex || editorLangId == latex",
          "group": "navigation"
        },
        {
          "command": "texPreview.openInBrowser",
          "when": "resourceExtname == .tex || editorLangId == latex",
          "group": "1_tex@1"
        },
        {
          "command": "texPreview.showSymbols",
          "when": "editorLangId =~ /^(la)?tex$/",
          "group": "navigation@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "texPreview.open",
          "when": "resourceExtname == .tex",
          "group": "1_open"
        }
      ],
      "explorer/context": [
        {
          "command": "texPreview.open",
          "when": "resourceExtname == .tex",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "texPreview.open",
          "when": "resourceExtname == .tex || editorLangId == latex",
          "group": "navigation@90"
        },
        {
          "command": "texPreview.syncToPdf",
          "when": "resourceExtname == .tex || editorLangId == latex",
          "group": "navigation@91"
        },
        {
          "submenu": "texPreview.latex",
          "when": "editorLangId =~ /^(la)?tex$/",
          "group": "navigation@92"
        },
        {
          "command": "texPreview.review.accept",
          "when": "editorLangId =~ /^(la)?tex$/ && texPreview.onChange",
          "group": "navigation@93"
        },
        {
          "command": "texPreview.review.reject",
          "when": "editorLangId =~ /^(la)?tex$/ && texPreview.onChange",
          "group": "navigation@94"
        },
        {
          "command": "texPreview.review.addComment",
          "when": "editorLangId =~ /^(la)?tex$/ && editorHasSelection",
          "group": "navigation@95"
        }
      ],
      "commandPalette": [
        {
          "command": "texPreview.open",
          "when": "resourceExtname == .tex || editorLangId == latex"
        },
        {
          "command": "texPreview.syncToPdf",
          "when": "resourceExtname == .tex || editorLangId == latex"
        },
        {
          "command": "texPreview.wordCount",
          "when": "editorLangId =~ /^(la)?tex$/"
        },
        {
          "command": "texPreview.wrap",
          "when": "editorLangId =~ /^(la)?tex$/"
        },
        {
          "command": "texPreview.wrapEnvironment",
          "when": "editorLangId =~ /^(la)?tex$/"
        },
        {
          "command": "texPreview.closeEnvironment",
          "when": "editorLangId =~ /^(la)?tex$/"
        },
        {
          "command": "texPreview.toggleDisplayMath",
          "when": "editorLangId =~ /^(la)?tex$/"
        },
        {
          "command": "texPreview.gotoMatchingEnvironment",
          "when": "editorLangId =~ /^(la)?tex$/"
        },
        {
          "command": "texPreview.endList",
          "when": "false"
        },
        {
          "command": "texPreview.bold",
          "when": "editorLangId =~ /^(la)?tex$/"
        },
        {
          "command": "texPreview.italic",
          "when": "editorLangId =~ /^(la)?tex$/"
        },
        {
          "command": "texPreview.emph",
          "when": "editorLangId =~ /^(la)?tex$/"
        },
        {
          "command": "texPreview.typewriter",
          "when": "editorLangId =~ /^(la)?tex$/"
        },
        {
          "command": "texPreview.underline",
          "when": "editorLangId =~ /^(la)?tex$/"
        },
        {
          "command": "texPreview.smallCaps",
          "when": "editorLangId =~ /^(la)?tex$/"
        },
        {
          "command": "texPreview.footnote",
          "when": "editorLangId =~ /^(la)?tex$/"
        },
        {
          "command": "texPreview.wrapMath",
          "when": "editorLangId =~ /^(la)?tex$/"
        },
        {
          "command": "texPreview.promoteSection",
          "when": "editorLangId =~ /^(la)?tex$/"
        },
        {
          "command": "texPreview.demoteSection",
          "when": "editorLangId =~ /^(la)?tex$/"
        },
        {
          "command": "texPreview.toggleStar",
          "when": "editorLangId =~ /^(la)?tex$/"
        },
        {
          "command": "texPreview.review.createComment",
          "when": "false"
        },
        {
          "command": "texPreview.review.reply",
          "when": "false"
        },
        {
          "command": "texPreview.review.resolve",
          "when": "false"
        },
        {
          "command": "texPreview.review.reopen",
          "when": "false"
        },
        {
          "command": "texPreview.review.deleteThread",
          "when": "false"
        },
        {
          "command": "texPreview.review.editComment",
          "when": "false"
        },
        {
          "command": "texPreview.review.deleteComment",
          "when": "false"
        },
        {
          "command": "texPreview.review.saveComment",
          "when": "false"
        },
        {
          "command": "texPreview.review.cancelEdit",
          "when": "false"
        },
        {
          "command": "texPreview.review.accept",
          "when": "editorLangId =~ /^(la)?tex$/"
        },
        {
          "command": "texPreview.review.reject",
          "when": "editorLangId =~ /^(la)?tex$/"
        },
        {
          "command": "texPreview.review.acceptAll",
          "when": "editorLangId =~ /^(la)?tex$/"
        },
        {
          "command": "texPreview.review.rejectAll",
          "when": "editorLangId =~ /^(la)?tex$/"
        },
        {
          "command": "texPreview.review.nextChange",
          "when": "editorLangId =~ /^(la)?tex$/"
        },
        {
          "command": "texPreview.review.previousChange",
          "when": "editorLangId =~ /^(la)?tex$/"
        },
        {
          "command": "texPreview.review.addComment",
          "when": "editorLangId =~ /^(la)?tex$/"
        }
      ],
      "texPreview.latex": [
        {
          "submenu": "texPreview.format",
          "group": "1_edit@1"
        },
        {
          "command": "texPreview.wrap",
          "group": "1_edit@2"
        },
        {
          "command": "texPreview.wrapEnvironment",
          "group": "1_edit@3"
        },
        {
          "submenu": "texPreview.structure",
          "group": "1_edit@4",
          "when": "texPreview.structure"
        },
        {
          "submenu": "texPreview.reviewMenu",
          "group": "1_edit@5"
        },
        {
          "command": "texPreview.insertSymbol",
          "group": "2_insert@1"
        },
        {
          "command": "texPreview.showSymbols",
          "group": "2_insert@2"
        },
        {
          "command": "texPreview.wordCount",
          "group": "3_doc@1"
        },
        {
          "command": "texPreview.openInBrowser",
          "group": "3_doc@2"
        },
        {
          "command": "texPreview.openExternal",
          "group": "3_doc@3"
        },
        {
          "command": "texPreview.clean",
          "group": "3_doc@4"
        }
      ],
      "texPreview.format": [
        {
          "command": "texPreview.bold",
          "group": "1@0"
        },
        {
          "command": "texPreview.italic",
          "group": "1@1"
        },
        {
          "command": "texPreview.emph",
          "group": "1@2"
        },
        {
          "command": "texPreview.typewriter",
          "group": "1@3"
        },
        {
          "command": "texPreview.underline",
          "group": "1@4"
        },
        {
          "command": "texPreview.smallCaps",
          "group": "1@5"
        },
        {
          "command": "texPreview.footnote",
          "group": "1@6"
        },
        {
          "command": "texPreview.wrapMath",
          "group": "1@7"
        }
      ],
      "texPreview.structure": [
        {
          "command": "texPreview.promoteSection",
          "group": "1_heading@1",
          "when": "texPreview.onHeading"
        },
        {
          "command": "texPreview.demoteSection",
          "group": "1_heading@2",
          "when": "texPreview.onHeading"
        },
        {
          "command": "texPreview.toggleStar",
          "group": "1_heading@3",
          "when": "texPreview.canStar"
        },
        {
          "command": "texPreview.toggleDisplayMath",
          "group": "2_env@1",
          "when": "texPreview.inDisplayMath"
        },
        {
          "command": "texPreview.closeEnvironment",
          "group": "2_env@2",
          "when": "texPreview.canCloseEnvironment"
        },
        {
          "command": "texPreview.gotoMatchingEnvironment",
          "group": "2_env@3",
          "when": "texPreview.inEnvironment"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "texPreview.review.createComment",
          "group": "inline",
          "when": "commentController == texReview && commentThreadIsEmpty"
        },
        {
          "command": "texPreview.review.reply",
          "group": "inline",
          "when": "commentController == texReview && !commentThreadIsEmpty"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "texPreview.review.resolve",
          "group": "inline@1",
          "when": "commentController == texReview && commentThread == open"
        },
        {
          "command": "texPreview.review.reopen",
          "group": "inline@1",
          "when": "commentController == texReview && commentThread == resolved"
        },
        {
          "command": "texPreview.review.deleteThread",
          "group": "inline@2",
          "when": "commentController == texReview && !commentThreadIsEmpty"
        }
      ],
      "comments/comment/title": [
        {
          "command": "texPreview.review.editComment",
          "group": "inline@1",
          "when": "commentController == texReview && comment == mine"
        },
        {
          "command": "texPreview.review.deleteComment",
          "group": "inline@2",
          "when": "commentController == texReview && comment == mine"
        }
      ],
      "comments/comment/context": [
        {
          "command": "texPreview.review.cancelEdit",
          "group": "inline@1",
          "when": "commentController == texReview"
        },
        {
          "command": "texPreview.review.saveComment",
          "group": "inline@2",
          "when": "commentController == texReview"
        }
      ],
      "texPreview.reviewMenu": [
        {
          "command": "texPreview.review.toggleTracking",
          "group": "1_track@1"
        },
        {
          "command": "texPreview.review.addComment",
          "group": "2_comment@1",
          "when": "editorHasSelection"
        },
        {
          "command": "texPreview.review.showComments",
          "group": "2_comment@2"
        },
        {
          "command": "texPreview.review.accept",
          "group": "3_change@1",
          "when": "texPreview.onChange"
        },
        {
          "command": "texPreview.review.reject",
          "group": "3_change@2",
          "when": "texPreview.onChange"
        },
        {
          "command": "texPreview.review.acceptAll",
          "group": "4_all@1",
          "when": "texPreview.hasChanges"
        },
        {
          "command": "texPreview.review.rejectAll",
          "group": "4_all@2",
          "when": "texPreview.hasChanges"
        },
        {
          "command": "texPreview.review.nextChange",
          "group": "5_nav@1",
          "when": "texPreview.hasChanges"
        },
        {
          "command": "texPreview.review.previousChange",
          "group": "5_nav@2",
          "when": "texPreview.hasChanges"
        }
      ]
    },
    "keybindings": [
      {
        "command": "texPreview.open",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorTextFocus && (resourceExtname == .tex || editorLangId == latex)"
      },
      {
        "command": "texPreview.compile",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && (resourceExtname == .tex || editorLangId == latex)"
      },
      {
        "command": "texPreview.syncToPdf",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j",
        "when": "editorTextFocus && (resourceExtname == .tex || editorLangId == latex)"
      },
      {
        "command": "texPreview.bold",
        "key": "alt+l b",
        "mac": "ctrl+l b",
        "when": "editorTextFocus && editorLangId =~ /^(la)?tex$/"
      },
      {
        "command": "texPreview.italic",
        "key": "alt+l i",
